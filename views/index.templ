package views

import "github.com/sumit-poudel/astral/views/templates"
import "github.com/sumit-poudel/astral/cmd/web/model"

templ index() {
}

templ InderRenderer(data model.TemplateData) {
	<html class="">
		@templates.Head("index - Astral")
		<body class="bg-surface">
			@templates.NavBar(data.UserName, data.IsAuthenticated)
			@templates.Container() {
				@index()
			}
			@templates.Modal() {
			}
		</body>
	</html>
}
