package templates

templ trigger() {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		fill="none"
		viewBox="0 0 24 24"
		stroke-width="1.5"
		stroke="currentColor"
		class="size-6"
	>
		<path
			stroke-linecap="round"
			stroke-linejoin="round"
			d="M17.982 18.725A7.488 7.488 0 0 0 12 15.75a7.488 7.488 0 0 0-5.982 2.975m11.963 0a9 9 0 1 0-11.963 0m11.963 0A8.966 8.966 0 0 1 12 21a8.966 8.966 0 0 1-5.982-2.275M15 9.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"
		></path>
	</svg>
}

templ NavBar(name string, isAuthenticated bool) {
	<header class="sticky top-0 z-50 border-b border-border ">
		<div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
			<div class="flex min-w-0 items-center gap-4">
				<a href="/" class="flex shrink-0 items-center">
					<img
						class="size-8"
						src="/static/assets/logo.svg"
						alt="Astral logo"
					/>
					<span class="ml-3 whitespace-nowrap text-xl font-semibold text-foreground max-sm:hidden">
						Astral
					</span>
				</a>
				<div
					class="relative hidden w-64 shrink-0 items-center rounded-full bg-surface-muted px-3 py-1.5 text-foreground-muted focus-within:ring-2 focus-within:ring-foreground-subtle md:flex"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="size-4 shrink-0"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="m21 21-4.34-4.34M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z"
						></path>
					</svg>
					<input
						type="text"
						placeholder="Type here"
						class="w-full bg-transparent pl-2 text-sm text-foreground outline-none placeholder:text-foreground-subtle"
					/>
				</div>
			</div>
			<div class="flex shrink-0 items-center gap-1 sm:gap-2.5">
				<button
					type="button"
					aria-label="Search"
					class="rounded-full p-2 text-foreground-muted transition hover:bg-surface-muted hover:text-foreground md:hidden"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="size-5"
						fill="none"
						viewBox="0 0 24 24"
						stroke="currentColor"
						stroke-width="2"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="m21 21-4.34-4.34M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z"
						></path>
					</svg>
				</button>
				if len(name) !=0 {
					<div class="text-foreground-muted">welcome back { name } !</div>
				}
				<button
					type="button"
					aria-label="Notifications"
					class="relative rounded-full p-2 text-foreground-muted transition hover:bg-surface-muted hover:text-foreground"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 24 24"
						stroke-width="1.5"
						stroke="currentColor"
						class="size-6"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"
						></path>
					</svg>
					<span class="absolute right-2 top-1.5 size-2 rounded-full bg-red-500"></span>
				</button>
				<button
					type="button"
					aria-label="Messages"
					class="rounded-full p-2 text-foreground-muted transition hover:bg-surface-muted hover:text-foreground"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						fill="none"
						viewBox="0 0 24 24"
						stroke-width="1.5"
						stroke="currentColor"
						class="size-6"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							d="M9 3.75H6.912a2.25 2.25 0 0 0-2.15 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859M12 3v8.25m0 0-3-3m3 3 3-3"
						></path>
					</svg>
				</button>
				@Options(trigger()) {
					if isAuthenticated {
						<form action="/logout" method="POST">
							<button type="submit">logout</button>
						</form>
					} else {
						<button data-on:click="$optionsOpen = false ;@get('/login')">login</button>
					}
				}
			</div>
		</div>
	</header>
}
